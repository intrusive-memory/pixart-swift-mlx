# graphify codemap: commit only the portable map artifacts (no absolute paths,
# reproducible meaning). Everything else under graphify-out/ is machine-specific
# or regenerable scratch — the absolute-path manifest.json, the semantic cache,
# dated backup snapshots, and detection markers.
graphify-out/*
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
